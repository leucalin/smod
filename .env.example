# Neon Postgres 数据库连接串
# 从 Neon 控制台 (https://console.neon.tech) 的项目 Settings → Connection string 复制
# 未配置 DATABASE_URL 时，系统自动使用内存演示数据（仅本地开发调试用）
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# 网易云音乐 API（可选）
# 默认已内置：服务端直接在当前进程内调用 @neteasecloudmusicapienhanced/api 模块，
# 无需单独部署网易云 API 服务。
# 仅当希望改用独立部署的 NeteaseCloudMusicApiEnhanced 服务时，才配置此地址：
#   PORT=3100 npx @neteasecloudmusicapienhanced/api
# NETEASE_API_BASE=http://127.0.0.1:3100

# 网易云出口 IP 标识（可选，部署在海外节点时建议配置）
# 服务端所有网易云请求都会携带该 IP（X-Real-IP），使网易云认为请求来自国内，
# 可缓解海外 IP 导致的播放受限与风控。填一个国内 IP 即可（无需是你自己的 IP）：
# NETEASE_REAL_IP=116.25.146.177

# bilibili 请求代理（可选，部署在海外节点时建议配置）
# bilibili 对海外 IP 会返回 412（搜索与取流都会失败）。
# 配置一个国内 HTTP(S) 代理后，所有 bilibili 请求都经由它发出，例如：
#   BILIBILI_PROXY=http://user:password@1.2.3.4:8080
# 国内任意一台可运行代理的服务器均可（tinyproxy / gost / squid 等）
# BILIBILI_PROXY=

